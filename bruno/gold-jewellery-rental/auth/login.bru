script:post-response {
  const data = res.getBody();
  if (data && data.data && data.data.accessToken) {
    bru.setVar("buyerToken", data.data.accessToken);
  }
}

docs {
  Authenticates a user and returns a JWT access token.
  Copy the returned accessToken into the buyerToken / supplierToken / adminToken
  environment variable as appropriate.
  The post-response script auto-saves the token to buyerToken.
}
