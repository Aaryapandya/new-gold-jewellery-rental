meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Priya Sharma",
    "email": "priya@example.com",
    "password": "P@ssword1",
    "mobileNumber": "9876543210",
    "role": "BUYER"
  }
}

docs {
  Creates a new BUYER or SUPPLIER account.
  Role must be one of: BUYER, SUPPLIER
  Password must contain: uppercase, lowercase, digit, special character (@$!%*?&).
  Returns a JWT access token on success (201 Created).
}
