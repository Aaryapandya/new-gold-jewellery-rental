meta {
  name: Verify User Email
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/admin/users/{{userId}}/verify-email
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:query {
  verified: true
}

docs {
  Toggles the emailVerified flag for a user.
  verified: true to mark as verified, false to unverify.
  Requires ADMIN role.
}
