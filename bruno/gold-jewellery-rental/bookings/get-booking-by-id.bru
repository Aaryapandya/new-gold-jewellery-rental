meta {
  name: Get Booking by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/bookings/{{bookingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyerToken}}
}

docs {
  Returns the full details of a single booking.
  Accessible by the buyer, the supplier involved, or an admin.
  Use buyerToken, supplierToken, or adminToken as appropriate.
}
